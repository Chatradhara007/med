{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PlanEntry",
  "description": "Day-by-day care schedule slot stored under PK = PATIENT#<id>, SK = PLAN#<day_index>#<slot>",
  "type": "object",
  "required": ["day_index", "slot", "action", "med_ref", "done", "provenance"],
  "properties": {
    "day_index": { "type": "integer", "minimum": 0, "maximum": 6 },
    "slot": { "type": "string", "enum": ["morning", "afternoon", "evening", "night"] },
    "action": { "type": "string", "minLength": 1 },
    "med_ref": { "type": "string", "minLength": 1 },
    "time_target": { "type": ["string", "null"] },
    "done": { "type": "boolean", "default": false },
    "completed_at": { "type": ["string", "null"] },
    "provenance": { "$ref": "provenance.json" }
  },
  "additionalProperties": false
}

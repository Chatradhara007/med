{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "LabResult",
  "description": "Laboratory analyte record stored under PK = PATIENT#<id>, SK = LAB#<iso_ts>#<analyte>",
  "type": "object",
  "required": ["analyte", "value", "unit", "provenance"],
  "properties": {
    "analyte": { "type": "string", "minLength": 1 },
    "value": { "oneOf": [{ "type": "number" }, { "type": "string" }] },
    "unit": { "type": "string", "minLength": 1 },
    "ref_low": { "type": ["number", "null"] },
    "ref_high": { "type": ["number", "null"] },
    "ref_source": { "type": "string", "enum": ["printed", "fallback_ref_ranges"], "default": "printed" },
    "deviation_score": { "type": ["number", "null"] },
    "flag": { "type": ["string", "null"], "enum": ["normal", "high", "low", "critical", null] },
    "provenance": { "$ref": "provenance.json" }
  },
  "additionalProperties": false
}

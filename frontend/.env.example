# CareThread web app configuration.
#
# Every value below is a public identifier from the CloudFormation stack
# outputs. None of them are secrets, and no AWS access key ever belongs here:
# the browser authenticates with a Cognito token and uploads through presigned
# S3 URLs precisely so it never holds credentials.
#
#   aws cloudformation describe-stacks --stack-name carethread \
#     --query "Stacks[0].Outputs" --output table

VITE_AWS_REGION=us-east-1

# UserPoolId output
VITE_COGNITO_USER_POOL_ID=

# ClientId output
VITE_COGNITO_USER_POOL_CLIENT_ID=

# HostedUiUrl output, WITHOUT the https:// prefix
# e.g. carethread-<name>-<account>.auth.us-east-1.amazoncognito.com
VITE_COGNITO_DOMAIN=

# ApiUrl output
VITE_API_GATEWAY_URL=

# Optional. Must match a CallbackURL registered on the user pool client
# exactly, trailing slash included, or Cognito rejects the sign-in with
# redirect_mismatch. Defaults to the page origin plus a trailing slash.
# VITE_REDIRECT_URI=https://your-app.amplifyapp.com/
